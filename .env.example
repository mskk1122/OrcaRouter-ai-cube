# Copy to .env. Keep this key local; never paste it in source or a screenshot.
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_MODEL=google/gemini-2.5-flash
ORCAROUTER_TTS_MODEL=openai/tts-1
ORCAROUTER_VOICE=alloy
# Confirm CARD identifiers with arecord -l and aplay -l on YOUR Pi.
CUBE_CAPTURE_DEVICE=plughw:CARD=Device,DEV=0
CUBE_PLAYBACK_DEVICE=plughw:CARD=MAX98357A,DEV=0
CUBE_VOLUME=0.25
CUBE_RMS_THRESHOLD=550
CUBE_MAX_RECORD_SECONDS=12
CUBE_API_TIMEOUT=45
CUBE_ROTATION=0
GPIOZERO_PIN_FACTORY=lgpio
